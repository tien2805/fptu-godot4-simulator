; Engine configuration file.
; File: res://project.godot
config_version=5

[application]
config/name="FPTU Student Simulator: Godot 4 Edition"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")

[autoload]
StageManager="*res://scripts/StageManager.gd"
GameFX="*res://scripts/GameFX.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[physics]

; Godot 4.4+ dùng Jolt: mặc định Area3D KHÔNG phát hiện StaticBody3D.
; Bật để vùng near-miss của xe máy thấy được xe buýt / xe máy NPC / xe tải (StaticBody3D).
jolt_physics_3d/simulation/areas_detect_static_bodies=true

[rendering]

; Đồ hoạ "nặng cũng được": Forward+, MSAA 2x + FXAA, debanding, lọc dị hướng 8x,
; shadow map 8192 với bóng mềm chất lượng cao, SSAO/SSIL/SSR chất lượng cao, SDFGI hội tụ nhanh,
; sương thể tích độ phân giải cao. Các màn gọi GameFX.upgrade_scene_visuals() để bật SDFGI/SSIL/ACES theo preset.
renderer/rendering_method="forward_plus"
textures/default_filters/anisotropic_filtering_level=3
textures/default_filters/texture_mipmap_bias=-0.2
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_debanding=true
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/atlas_size=8192
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=3
environment/ssao/half_size=false
environment/ssil/quality=3
environment/ssil/half_size=false
environment/screen_space_reflection/roughness_quality=3
environment/glow/upscale_mode=1
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=160
environment/volumetric_fog/use_filter=1
global_illumination/sdfgi/probe_ray_count=2
global_illumination/sdfgi/frames_to_converge=4
global_illumination/sdfgi/frames_to_update_lights=1
global_illumination/gi/use_half_resolution=false
reflections/sky_reflections/roughness_layers=10
reflections/sky_reflections/ggx_samples=64
